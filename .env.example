# LLM Configuration
GOOGLE_API_KEY_1=api key one
GOOGLE_API_KEY_2=api key two
GOOGLE_API_KEY_3=api key three
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# App Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Memory Configuration
MEMORY_BACKEND=dict
MAX_SUMMARIES=5

# Redis (only needed if MEMORY_BACKEND=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500","http://[::1]:3000"]